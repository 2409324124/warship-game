{
  "name": "warship-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WWII naval gunnery game - procedural ship models, ballistic dispersion, Ironbottom Sound style",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
